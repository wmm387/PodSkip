<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="耳机按键测试"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="换上任何一副耳机，在这里按两下就知道要不要调参数"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="有线耳机接上就能识别。蓝牙耳机需要在「高级设置 → 蓝牙耳机」里开启接管，并停在白名单应用里按；蓝牙键会显示成媒体键（126/127 播放暂停、87/88 下一个/上一个），不走单击双击判定。同一个键反复按可能一直显示 PAUSE，那是耳机只发这一个码，正常。"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/probe_big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="等待按键…"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/probe_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="按一下耳机上的按键"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/probe_advice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="4dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="采用建议值" />

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="清零重测" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="按键记录"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/probe_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:text="（还没有记录）"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/probe_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="4dp"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
