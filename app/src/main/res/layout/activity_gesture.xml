<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="设置"
                android:textColor="@color/on_surface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="恢复默认"
                android:textColor="@color/on_primary_container"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="滑动参数改完立即生效，不用重启服务"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/label_from"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="上滑起点"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seek_from"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/label_to"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="上滑终点"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seek_to"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/label_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="滑动时长"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seek_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/label_window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="多击判定窗口"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seek_window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="窗口越大，慢速连按越不容易被拆成两次单击，但单击暂停的等待也越久。"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_key_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="耳机按键测试" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:lineSpacingExtra="3dp"
            android:text="按键模式、单击接管、横屏适配、长按防误触、佩戴检测这些开关，都在高级设置里。"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_advanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="高级设置" />

        <Button
            android:id="@+id/btn_onboarding_again"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_gravity="start"
            android:minWidth="0dp"
            android:text="重新查看开启引导"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_export_log"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:minWidth="0dp"
            android:text="导出诊断日志"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_feedback"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:minWidth="0dp"
            android:text="反馈问题（GitHub）"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:text="按键没反应时，先导出日志，再到 GitHub 提一条 issue 并把文件附上。日志只存在本机，App 没有联网权限，不会自动上传。"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
